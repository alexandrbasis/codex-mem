{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sealed prospective semantic-review findings v1",
  "description": "Private reviewer artifact only. Never parent/model-reader input. The driver hashes this artifact without parsing it; reviewer checks semantics and complete coverage. Accepted review requires all checks true and zero unresolved findings. Schema structure alone cannot establish entailment or independence.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "unresolved_findings",
    "reviewer_identity",
    "independence_attestation",
    "input_hashes",
    "question_reviews"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "status": {
      "enum": [
        "accepted",
        "changes_required"
      ]
    },
    "unresolved_findings": {
      "type": "integer",
      "minimum": 0
    },
    "reviewer_identity": {
      "type": "string",
      "minLength": 1
    },
    "independence_attestation": {
      "const": "independent_author_inputs_only_no_product_prior_inputs_answers_or_grades"
    },
    "input_hashes": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fixture_sha256",
        "gold_sha256",
        "mechanical_contract_sha256",
        "semantic_guidance_sha256"
      ],
      "properties": {
        "fixture_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gold_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "mechanical_contract_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "semantic_guidance_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "author_fact_rationale_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "question_reviews": {
      "type": "array",
      "minItems": 96,
      "maxItems": 96,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "required_facts",
          "optional_background",
          "negative_case_findings",
          "question_requirements_complete",
          "difficult_scenarios_preserved"
        ],
        "properties": {
          "case": {
            "type": "string",
            "minLength": 1
          },
          "required_facts": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "fact_index",
                "question_clause",
                "proposition",
                "support",
                "checks",
                "finding"
              ],
              "properties": {
                "fact_index": {
                  "type": "integer",
                  "minimum": 0
                },
                "question_clause": {
                  "type": "string",
                  "minLength": 1
                },
                "proposition": {
                  "type": "string",
                  "minLength": 1
                },
                "support": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "event_id",
                      "source_field",
                      "start",
                      "end",
                      "quote"
                    ],
                    "properties": {
                      "event_id": {
                        "type": "string",
                        "minLength": 1
                      },
                      "source_field": {
                        "type": "string",
                        "minLength": 1
                      },
                      "start": {
                        "type": "integer",
                        "minimum": 0
                      },
                      "end": {
                        "type": "integer",
                        "minimum": 1
                      },
                      "quote": {
                        "type": "string",
                        "minLength": 1
                      }
                    }
                  }
                },
                "checks": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "question_responsive",
                    "source_entails_proposition",
                    "all_required_conjuncts_preserved",
                    "scope_role_time_permission_preserved",
                    "minimal_sufficient_surviving_support",
                    "negative_cases_consistent"
                  ],
                  "properties": {
                    "question_responsive": {
                      "type": "boolean"
                    },
                    "source_entails_proposition": {
                      "type": "boolean"
                    },
                    "all_required_conjuncts_preserved": {
                      "type": "boolean"
                    },
                    "scope_role_time_permission_preserved": {
                      "type": "boolean"
                    },
                    "minimal_sufficient_surviving_support": {
                      "type": "boolean"
                    },
                    "negative_cases_consistent": {
                      "type": "boolean"
                    }
                  }
                },
                "finding": {
                  "type": "string"
                }
              }
            }
          },
          "optional_background": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "negative_case_findings": {
            "type": "string"
          },
          "question_requirements_complete": {
            "type": "boolean"
          },
          "difficult_scenarios_preserved": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
