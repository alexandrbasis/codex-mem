+def _descriptive_compounds(query: str) -> set[str]:
+    """Recognize alphabetic modifiers by syntax, without interpreting names.
+
+    A following ordinary word supplies the descriptive head. Function words
+    cannot supply that head. Every occurrence must have the same safe shape,
+    so a second bare use cannot silently lose its identity constraint.
+    """
+    function_word = re.compile(
+        r'(?:a|an|the|and|or|with|versus|vs|for|in|from|to|on|about|regarding|within|of|'
+        r'across|between|after|before|by|as|at|is|are|was|were|has|have|had|does|do|did|'
+        r'can|could|may|might|must|should|will|would|not|only|it|its|this|that|these|those)', re.I)
+    occurrences: dict[str, list[bool]] = {}
+    for match in re.finditer(r'(?<![\w./:-])([A-Za-z]+(?:-[A-Za-z]+)+)(?![\w./:-])', query):
+        head = re.match(r'\s+([A-Za-z]+)(?![\w./:-])', query[match.end():])
+        ordinary = bool(head and not re.search(r'[a-z][A-Z]', match.group(1)) and
+                        not function_word.fullmatch(head.group(1)) and
+                        not re.search(r'[a-z][A-Z]', head.group(1)) and
+                        not re.match(r'\s*\(', query[match.end() + head.end():]) and
+                        not re.search(r'\bprojects?\s+$', query[:match.start()], re.I))
+        occurrences.setdefault(match.group(1).casefold(), []).append(ordinary)
+    return {value for value, modifiers in occurrences.items() if all(modifiers)}
+
