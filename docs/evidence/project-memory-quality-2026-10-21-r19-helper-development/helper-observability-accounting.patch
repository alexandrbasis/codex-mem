+class FailureReasonObservabilityTests(unittest.TestCase):
+    def test_failed_native_ledger_keeps_only_allowlisted_reason_and_unknown_usage(self):
+        from codex_mem.processor import ProcessorFailure
+        cases = [('runner_failure', 'native_usage_limit', 'native_usage_limit'),
+                 ('invalid_response', 'invalid_json', 'invalid_json'),
+                 ('runner_failure', 'private remote prose with worker-secret', None),
+                 ('timeout', 'native_usage_limit', None),
+                 ('runner_failure', {'remote':'worker-secret'}, None)]
+        for code, reason, expected in cases:
+            with self.subTest(code=code, reason=reason), tempfile.TemporaryDirectory() as temporary:
+                run=Path(temporary)
+                experiment.write(run/'run.json',{'started_at':experiment.time.time(),'budget_run':str(run)})
+                protocol={'model':'gpt-6-luna','reasoning_effort':'medium','limits':{
+                    'max_calls':5,'max_observed_tokens':1000000,'per_call_token_reservation':100000,
+                    'wall_seconds':3600,'call_seconds':1}}
+                capture=experiment.Capture(run,protocol,'judge','candidate','public-fiction')
+                request=experiment.request('Public fictional input only.',experiment.object_schema({'value':experiment.TEXT}),protocol)
+                error=ProcessorFailure(code,reason_code=reason,worker_thread_id='worker-secret',worker_turn_id='turn-secret')
+                # A runner-compatible exception may expose arbitrary attributes;
+                # Capture must apply the allowlist itself rather than trust it.
+                error.reason_code=reason
+                error.remote_detail='private remote prose with worker-secret'
+                with patch('codex_mem.processor.NativeProcessorRunner') as runner:
+                    runner.return_value.side_effect=error
+                    with self.assertRaises(ProcessorFailure):capture(request)
+                    rows=experiment.ledger_calls(run/'calls.jsonl')
+                    self.assertEqual([row['status'] for row in rows],['started','failed'])
+                    self.assertEqual(rows[-1]['error_code'],code)
+                    self.assertIn('reason_code',rows[-1])
+                    self.assertEqual(rows[-1]['reason_code'],expected)
+                    serialized=json.dumps(rows)
+                    for secret in ('worker-secret','turn-secret','private remote prose','remote_detail'):
+                        self.assertNotIn(secret,serialized)
+                    usage=experiment.usage(rows)
+                    self.assertFalse(usage['token_accounting_complete'])
+                    self.assertIsNone(usage['tokens']['total_tokens'])
+                    self.assertIsNone(usage['cost_usd'])
+                    self.assertEqual(experiment.read(run/'receipts/call-0001-request.json'),request)
+                    self.assertFalse((run/'receipts/call-0001-response.json').exists())
+                    with self.assertRaisesRegex(RuntimeError,'usage_unknown_stop'):
+                        capture(request)
+                    self.assertEqual(runner.call_count,1)
+                    self.assertEqual(len(experiment.ledger_calls(run/'calls.jsonl')),2)
+
