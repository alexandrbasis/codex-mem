+class CumulativeReportedBoundsTests(unittest.TestCase):
+    def accounting(self, root, prior, current):
+        import hashlib
+        path=root/'prior-report.json'
+        experiment.write(path,{'usage':prior})
+        protocol={'historical_spend':{'report':str(path),'sha256':hashlib.sha256(path.read_bytes()).hexdigest()}}
+        return experiment.historical_accounting(protocol,current)['cumulative_pilot_usage']
+
+    def test_three_round_unknown_prior_preserves_known_reported_bounds(self):
+        prior=experiment.usage(model_call('known','reader','baseline',100)+[
+            {'call_id':'unknown','status':'started','phase':'reader','variant':'candidate'}])
+        expected=[{'input_tokens':280,'cached_input_tokens':0,'output_tokens':20,'total_tokens':300},
+                  {'input_tokens':320,'cached_input_tokens':0,'output_tokens':30,'total_tokens':350},
+                  {'input_tokens':335,'cached_input_tokens':0,'output_tokens':40,'total_tokens':375}]
+        with tempfile.TemporaryDirectory() as temporary:
+            for total,bound in zip((200,50,25),expected):
+                current=experiment.usage(model_call('new-'+str(total),'reader','candidate',total))
+                prior=self.accounting(Path(temporary),prior,current)
+                self.assertFalse(prior['token_accounting_complete'])
+                self.assertIsNone(prior['tokens']['total_tokens'])
+                self.assertEqual(prior.get('reported_tokens_lower_bound'),bound)
+                self.assertTrue(prior['reported_tokens_lower_bound_coverage_complete'])
+                self.assertEqual(prior['reported_tokens_lower_bound_missing_components'],0)
+                self.assertEqual(prior['reported_tokens_lower_bound_scope'],'known_reported_receipts_only_not_total_usage')
+                self.assertIsNone(prior['cost_usd'])
+
+    def test_missing_bounds_do_not_become_zero_or_disappear_on_next_round(self):
+        unknown=experiment.usage([{'call_id':'unknown','status':'started'}])
+        unknown.pop('reported_tokens_lower_bound')
+        known=experiment.usage(model_call('known','reader','candidate',100))
+        with tempfile.TemporaryDirectory() as temporary:
+            both=self.accounting(Path(temporary),unknown,unknown)
+            self.assertIsNone(both['reported_tokens_lower_bound'])
+            self.assertFalse(both['reported_tokens_lower_bound_coverage_complete'])
+            self.assertEqual(both['reported_tokens_lower_bound_missing_components'],2)
+            partial=self.accounting(Path(temporary),unknown,known)
+            self.assertEqual(partial['reported_tokens_lower_bound']['total_tokens'],100)
+            self.assertEqual(partial['reported_tokens_lower_bound_missing_components'],1)
+            again=self.accounting(Path(temporary),partial,experiment.usage(model_call('later','reader','candidate',20)))
+            self.assertEqual(again['reported_tokens_lower_bound']['total_tokens'],120)
+            self.assertEqual(again['reported_tokens_lower_bound_missing_components'],1)
+            self.assertFalse(again['reported_tokens_lower_bound_coverage_complete'])
+            self.assertFalse(again['token_accounting_complete'])
