+def _valid_reported_token_map(counts: object) -> dict | None:
+    keys = ('input_tokens', 'cached_input_tokens', 'output_tokens', 'total_tokens')
+    if (not isinstance(counts, dict) or set(counts) != set(keys)
+            or any(type(counts[key]) is not int or counts[key] < 0 for key in keys)
+            or counts['cached_input_tokens'] > counts['input_tokens']
+            or counts['total_tokens'] != counts['input_tokens'] + counts['output_tokens']):
+        return None
+    return {key: counts[key] for key in keys}
+
+
+def _reported_bound_component(value: dict) -> tuple[dict | None, int | None]:
+    """Keep valid known-reported subtotals separate from missing usage."""
+    bound = _valid_reported_token_map(value.get('reported_tokens_lower_bound'))
+    full = (_valid_reported_token_map(value.get('tokens')) if value.get('token_accounting_complete') is True else None)
+    if bound is not None and full is not None and any(bound[key] > full[key] for key in full):
+        bound = None
+    if bound is None:
+        bound = full
+    missing = value.get('reported_tokens_lower_bound_missing_components', 0 if bound is not None else 1)
+    coverage = value.get('reported_tokens_lower_bound_coverage_complete', missing == 0)
+    if (type(missing) is not int or missing < 0 or type(coverage) is not bool
+            or (bound is None and missing == 0) or (coverage is False and missing == 0)):
+        missing = None
+    return bound, missing
+
