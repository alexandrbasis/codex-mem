+def _coordinated_scope_identifiers(query: str) -> set[str]:
+    """Preserve existing hard names in syntactically introduced scope lists.
+
+    A bare conjunction is not a literal-identity marker. Scope-list syntax in
+    the original query must survive removal of its selected project name.
+    Only the old hyphen/conjunction candidates are retained here; this does
+    not turn an ordinary alphabetic topic into a new mandatory identifier.
+    """
+    atom = r'[A-Za-z_][A-Za-z0-9_.:-]*'
+    separator = r'(?:\s+(?:and|with|versus|vs)\s+|\s*,\s*(?:and\s+)?)'
+    lists = re.finditer(
+        rf'\b(?:for|in|from|to|on|about|regarding|within|of|project|projects|compare|versus|vs|between|across)\s+'
+        rf'{atom}(?P<tail>(?:{separator}{atom})+)', query, re.I)
+    identifiers = set()
+    for match in lists:
+        identifiers.update(name.casefold() for name in re.findall(rf'\band\s+({atom})',
+                           match.group('tail'), re.I) if '-' in name)
+    return identifiers
 
 
