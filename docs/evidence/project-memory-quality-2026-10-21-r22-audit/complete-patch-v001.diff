+def complete_shared_pipeline_receipts(protocol: dict) -> bool:
+    if 'pipeline_receipt_contract' not in protocol:
+        return False
+    if (protocol['pipeline_receipt_contract'] != 'complete-shared-pipeline-v1'
+            or independent_generation(protocol)):
+        raise ValueError('complete-shared-pipeline-v1 requires shared-prefix comparison')
+    return True
