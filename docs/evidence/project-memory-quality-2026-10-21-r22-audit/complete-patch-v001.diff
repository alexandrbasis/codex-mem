+
+Run only after canonical export is complete. The mandatory confirmation flag is
+an operator gate, not a claim that missing/incomplete evidence passed.
+"""
+from pathlib import Path
+import argparse
+import collections
+import hashlib
+import importlib.util
+import json
+import re
+import tarfile
+import urllib.parse
+
+
+def main():
