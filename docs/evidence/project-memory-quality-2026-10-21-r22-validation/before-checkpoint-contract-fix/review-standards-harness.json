  "findings": [
    {
      "id": "R22-STANDARDS-CHECKPOINT-PRODUCER-CONSUMER",
      "priority": "P2",
      "classification": "documented_standard_violation",
      "file": "docs/evidence/project-memory-quality-2026-10-21-r22-audit/pipeline_contract.py",
      "line": 54,
      "related_test": {
        "file": "docs/evidence/project-memory-quality-2026-10-21-r22-audit/test-pipeline-contract.py",
        "lines": [
          35,
          39
        ]
      },
      "standard": {
        "file": "CODING_STANDARDS.md",
        "rule": "Проверка и доказательства: Проверяйте наблюдаемое поведение и границы задачи. Для исправления ошибки воспроизведите сбой и проверьте исправление. Тест, который повторяет внутренние шаги реализации, не заменяет проверку результата."
      },
      "hunk": "set(tokens)=={'input_tokens','output_tokens','cached_input_tokens','total_tokens'}",
      "problem": "Actual Capture._save_checkpoint validates/normalizes through pricing.token_counts and persists six fields, also cache_write_input_tokens and reasoning_output_tokens. Therefore every valid reported/partial producer checkpoint fails auditor checkpoint_token_shape. The positive test supplies only four counters, so the real producer rejects the snapshot without writing a file; all(checks) succeeds on an empty list.",
      "reproduction": "On the held helper, sent valid reported six-counter usage (input7/output3/cached0/cache_write0/reasoning0/total10); asserted checkpoint file exists and inspected six emitted token keys; actual auditor returned checkpoint_token_shape:call-0001=False. Public synthetic temporary directory only.",
      "impact": "A real valid checkpoint makes the future actual integrity audit report a false gap. Existing green test claim does not exercise this producer/consumer boundary.",
      "required_change": "Accept and validate the actual six-counter bounded pricing contract, including cached+write/input and reasoning/output subset rules. Add an owning producer-to-consumer regression that asserts the checkpoint exists, exactly one receipt is checked and positive checks are nonempty, plus invalid/subset/bounds controls. Preserve final unknown usage and all RED evidence.",
      "status": "unresolved"
    }
  ],
