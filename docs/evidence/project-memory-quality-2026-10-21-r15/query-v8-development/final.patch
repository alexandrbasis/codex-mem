+def _current_request_reference(query: str) -> tuple[str, bool] | None:
+    """Recognize request fate/relation, without selecting an earlier time slice."""
+    if _EXPLICIT_AS_OF.search(query):
+        return None
+    question = _question_body(query)
+    fate = re.fullmatch(
+        r'(?:how\s+much|what\s+part)\s+of\s+(?:the\s+)?'
+        r'(?:earlier|previous|prior)\s+(?:(?P<subject>.+?)\s+)?'
+        r'(?:request|instruction|requirement)\s+(?:was|is|has\s+been)\s+'
+        r'(?:withdrawn|cancelled|canceled|removed|retained)', question, re.I)
+    if fate:
+        return fate.group('subject') or '', False
+    relation = re.fullmatch(
+        r'does\s+(?:the\s+)?(?:later|latest|current|new)\s+(?:request|instruction)\s+'
+        r'belong\s+to\s+(?:the\s+)?(?:earlier|previous|prior|existing)\s+'
+        r'(?:(?P<subject>.+?)\s+)?(?:task|work)', question, re.I)
+    if relation:
+        return relation.group('subject') or '', True
+    return None
+
